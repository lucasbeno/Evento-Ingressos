# Copie este arquivo para ".env" (na pasta backend/) e preencha com os dados
# da sua instância Postgres (ex: criada gratuitamente em https://neon.tech ou
# https://supabase.com). O arquivo .env não é versionado.

DATABASE_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DATABASE_USERNAME=<usuario>
DATABASE_PASSWORD=<senha>

SERVER_PORT=8080

# Gere um valor aleatório, ex: openssl rand -base64 48
JWT_SECRET=<segredo-aleatorio-de-pelo-menos-32-bytes>
JWT_EXPIRATION_MINUTES=1440

# Gere uma chave gratuita em developer.ticketmaster.com (Consumer Key)
TICKETMASTER_API_KEY=

# Gere um valor aleatório, ex: openssl rand -base64 48 (diferente do JWT_SECRET)
TICKET_QR_SECRET=<segredo-aleatorio-de-pelo-menos-32-bytes>
